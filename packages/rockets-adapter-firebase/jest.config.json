{
  "moduleFileExtensions": ["js", "json", "ts"],
  "roots": ["<rootDir>src"],
  "testRegex": ".\\.spec\\.ts$",
  "testPathIgnorePatterns": ["node_modules", "dist"],
  "testEnvironment": "node",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/../../tsconfig.jest.json"
      }
    ],
    "^.+\\.js$": [
      "babel-jest",
      {
        "configFile": false,
        "plugins": [
          "<rootDir>/../../scripts/babel-plugin-import-meta-url-filename.cjs",
          "<rootDir>/../../scripts/babel-plugin-dynamic-import-to-require.cjs",
          "@babel/plugin-transform-modules-commonjs"
        ]
      }
    ]
  },
  "moduleNameMapper": {
    "^@concepta/nestjs-core/aggregate$": "<rootDir>/../../node_modules/@concepta/nestjs-core/dist/index-aggregate"
  },
  "transformIgnorePatterns": ["node_modules/(?!(@nestjs|@concepta)/)"]
}
