{
  "name": "@concepta/rockets-core",
  "version": "1.0.0-alpha.8",
  "description": "Rockets Core - auth-provider-agnostic server infrastructure",
  "author": "Thiago Ramalho <thiago.ramalho@concepta.com>",
  "license": "BSD-3-Clause",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "standard-schema": [
        "dist/standard-schema/index.d.ts"
      ],
      "standard-schema/swagger": [
        "dist/standard-schema/swagger/index.d.ts"
      ],
      "zod": [
        "dist/zod/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./standard-schema": {
      "types": "./dist/standard-schema/index.d.ts",
      "require": "./dist/standard-schema/index.js",
      "import": "./dist/standard-schema/index.js"
    },
    "./standard-schema/swagger": {
      "types": "./dist/standard-schema/swagger/index.d.ts",
      "require": "./dist/standard-schema/swagger/index.js",
      "import": "./dist/standard-schema/swagger/index.js"
    },
    "./zod": {
      "types": "./dist/zod/index.d.ts",
      "require": "./dist/zod/index.js",
      "import": "./dist/zod/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conceptadev/rockets.git",
    "directory": "packages/rockets-core"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/**/!(*.spec|*.e2e-spec|*.fixture).{js,d.ts}",
    "README.md",
    "LICENSE.txt",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "prepack": "yarn run -T clean && yarn run -T build",
    "build:watch": "tsc -p tsconfig.json --watch",
    "test": "cd ../.. && ./node_modules/.bin/vitest run --project unit packages/rockets-core",
    "test:typetests": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.typetest.json",
    "test:e2e": "cd ../.. && ./node_modules/.bin/vitest run --project e2e-packages packages/rockets-core"
  },
  "dependencies": {
    "@concepta/nestjs-access-control": "8.0.0-alpha.8",
    "@concepta/nestjs-authentication": "8.0.0-alpha.8",
    "@concepta/nestjs-core": "8.0.0-alpha.8",
    "@concepta/nestjs-crud": "8.0.0-alpha.8",
    "@concepta/nestjs-repository": "8.0.0-alpha.8",
    "@nestjs/common": "12.0.0-alpha.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "12.0.0-alpha.5",
    "@nestjs/cqrs": "^11.0.0",
    "@nestjs/swagger": "12.0.0-alpha.2",
    "@standard-schema/spec": "1.1.0",
    "pluralize": "^8.0.0"
  },
  "devDependencies": {
    "@concepta/rockets-repository-typeorm": "workspace:^",
    "@nestjs/testing": "12.0.0-alpha.5",
    "@nestjs/typeorm": "11.0.3",
    "@types/pluralize": "^0.0.33",
    "accesscontrol": "^2.2.1",
    "nestjs-zod": "^5.4.0",
    "supertest": "^6.3.4",
    "typeorm": "^0.3.31",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "nestjs-zod": "^5.0.0",
    "rxjs": "^7.1.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "nestjs-zod": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "homepage": "https://github.com/conceptadev/rockets/tree/main/packages/rockets-core#readme",
  "bugs": {
    "url": "https://github.com/conceptadev/rockets/issues"
  },
  "keywords": [
    "nestjs",
    "rockets",
    "core",
    "crud",
    "repository",
    "typescript",
    "zod",
    "dependency-injection",
    "backend",
    "api",
    "standard-schema"
  ],
  "stableVersion": "0.0.1-dev.0"
}
