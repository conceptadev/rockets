{
  "name": "root",
  "version": "0.0.1-dev.0",
  "license": "BSD-3-Clause",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*",
      "examples/sample-code-review",
      "examples/sample-code-review/apps/*",
      "examples/sample-code-review/packages/*"
    ]
  },
  "resolutions": {
    "typeorm": "0.3.28",
    "@nestjs/typeorm": "11.0.3",
    "@nestjs/common": "12.0.0-alpha.5",
    "@nestjs/core": "12.0.0-alpha.5",
    "@nestjs/platform-express": "12.0.0-alpha.5",
    "@nestjs/testing": "12.0.0-alpha.5",
    "@nestjs/swagger": "12.0.0-alpha.2",
    "jws": "3.2.3",
    "qs": "6.15.2",
    "path-to-regexp": "8.4.0",
    "form-data": "4.0.6",
    "multer": "2.2.0",
    "tar-fs": "2.1.4",
    "js-yaml": "4.2.0",
    "tar": "7.5.16",
    "uuid@npm:^8.0.0": "npm:11.1.1",
    "@concepta/nestjs-access-control": "8.0.0-alpha.8",
    "@concepta/nestjs-authentication": "8.0.0-alpha.8",
    "@concepta/nestjs-crud": "8.0.0-alpha.8",
    "@concepta/nestjs-email": "7.0.0-alpha.10",
    "@concepta/nestjs-event": "7.0.0-alpha.10",
    "@concepta/nestjs-federated": "8.0.0-alpha.8",
    "@concepta/nestjs-invitation": "8.0.0-alpha.8",
    "@concepta/nestjs-otp": "8.0.0-alpha.8",
    "@concepta/nestjs-password": "8.0.0-alpha.8",
    "@concepta/nestjs-repository": "8.0.0-alpha.8",
    "@concepta/nestjs-repository-typeorm": "8.0.0-alpha.8",
    "@concepta/nestjs-role": "8.0.0-alpha.8",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@concepta/nestjs-user": "8.0.0-alpha.8",
    "@types/minimatch": "5.1.2",
    "lodash": "4.17.23",
    "@concepta/nestjs-core": "8.0.0-alpha.8",
    "@concepta/nestjs-cache": "8.0.0-alpha.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@concepta/eslint-config": "^1.1.4",
    "@concepta/prettier-config": "^1.1.4",
    "@darraghor/eslint-plugin-nestjs-typed": "^3.22.6",
    "@nestjs/cli": "12.0.0-alpha.6",
    "@nestjs/schematics": "12.0.0-alpha.9",
    "@nestjs/testing": "12.0.0-alpha.5",
    "@swc/core": "^1.15.47",
    "@types/express": "^4.17.21",
    "@types/node": "^18.19.44",
    "@types/nodemailer": "^6.4.15",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitest/coverage-v8": "^4.1.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.11.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-tsdoc": "^0.3.0",
    "husky": "^7.0.4",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jsonc-eslint-parser": "^2.4.0",
    "lerna": "^3.22.1",
    "markdownlint-cli": "^0.41.0",
    "patch-package": "^8.0.0",
    "prettier": "^2.8.8",
    "reflect-metadata": "^0.1.14",
    "rimraf": "^3.0.2",
    "rxjs": "^7.8.1",
    "standard-version": "^9.5.0",
    "supertest": "^7.1.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^3.15.0",
    "typedoc": "^0.25.13",
    "typedoc-plugin-coverage": "^3.3.0",
    "typeorm": "^0.3.20",
    "typescript": "^5.4.0",
    "unplugin-swc": "^1.5.10",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "postinstall": "husky install && patch-package",
    "clean": "./node_modules/.bin/rimraf packages/*/dist packages/*/tsconfig.tsbuildinfo docs",
    "build": "./node_modules/.bin/tsc --build",
    "prepublish": "yarn clean && yarn build",
    "watch": "yarn build && ./node_modules/.bin/tsc --build --watch",
    "lint": "eslint \"packages/*/src/**/*.{ts,js,json}\" \"examples/sample-server-auth/{src,test}/**/*.{ts,js}\"",
    "lint:fix": "yarn lint --fix",
    "lint:md": "markdownlint README.md packages/**/*.md examples/**/*.md --ignore '**/docs/code-analysis/**'",
    "lint:md:fix": "yarn lint:md --fix",
    "lint:all": "yarn lint && yarn lint:md",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --project unit --coverage --coverage.thresholds.statements=50 --coverage.thresholds.branches=50 --coverage.thresholds.functions=40 --coverage.thresholds.lines=50",
    "test:ci": "vitest run --project unit --coverage --coverage.thresholds.statements=50 --coverage.thresholds.branches=50 --coverage.thresholds.functions=40 --coverage.thresholds.lines=50 --reporter=default --reporter=junit --outputFile=junit.xml",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --project e2e-packages",
    "test:e2e:cov": "vitest run --project e2e-packages --coverage --coverage.reportsDirectory=coverage-e2e --maxWorkers=1",
    "test:all": "vitest run",
    "doc": "rimraf ./docs && typedoc",
    "doc:cov": "yarn doc --coverageOutputType all",
    "changelog": "standard-version",
    "changelog:minor": "standard-version --release-as minor",
    "changelog:patch": "standard-version --release-as patch",
    "changelog:major": "standard-version --release-as major",
    "generate-swagger": "cd packages/rockets-server-auth && yarn generate-swagger",
    "sample:start": "yarn workspace sample-server start:dev",
    "sample:go": "yarn build && yarn workspace sample-server start:dev",
    "sample:once": "yarn workspace sample-server start",
    "sample:dev": "yarn workspace sample-server start:dev",
    "sample:debug": "yarn workspace sample-server start:debug",
    "sample:build": "yarn workspace sample-server build",
    "sample:test:e2e": "yarn workspace sample-server test:e2e",
    "sample-auth:start": "yarn workspace sample-server-auth start",
    "sample-auth:dev": "yarn workspace sample-server-auth start:dev",
    "sample-auth:debug": "yarn workspace sample-server-auth start:debug",
    "sample-auth:build": "yarn workspace sample-server-auth build",
    "sample-auth:test:e2e": "yarn workspace sample-server-auth test:e2e",
    "sample-code-review:dev": "yarn build && yarn workspace sample-code-review dev",
    "sample-code-review:build": "yarn build && yarn workspace sample-code-review build",
    "sample-code-review:test:e2e": "yarn build && yarn workspace sample-code-review test:e2e",
    "samples:build": "yarn sample:build && yarn sample-auth:build",
    "samples:test:e2e": "yarn sample:test:e2e && yarn sample-auth:test:e2e",
    "pack:conceptadev:rockets": "yarn workspace @conceptadev/rockets pack",
    "pack:conceptadev:rockets-auth": "yarn workspace @conceptadev/rockets-auth pack",
    "publish:conceptadev": "yarn clean && yarn build && yarn workspaces foreach -A --include '@conceptadev/*' --topological --no-private npm publish --access public --tag dev",
    "codacy:analyze": ".codacy/cli.sh analyze",
    "codacy:analyze:fix": ".codacy/cli.sh analyze --fix",
    "codacy:analyze:file": ".codacy/cli.sh analyze",
    "codacy:analyze:security": ".codacy/cli.sh analyze -t trivy",
    "typecheck:spec": "tsc --noEmit -p tsconfig.spec.json && yarn workspace @conceptadev/rockets-core test:typetests"
  },
  "packageManager": "yarn@4.4.0",
  "dependencies": {
    "@nestjs/swagger": "12.0.0-alpha.2",
    "@nestjs/throttler": "^6.5.0",
    "helmet": "^8.1.0",
    "swagger-ui-express": "^5.0.1"
  }
}
